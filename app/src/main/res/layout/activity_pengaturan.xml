<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tinta"
            android:padding="14dp"
            android:text="Setelan"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cara tercepat: di laptop buka tab Checkpoint (QR), lalu pindai QR &quot;Hubungkan HP&quot; dari layar utama aplikasi ini. Alamat dan PIN terisi otomatis."
                android:textColor="@color/redup"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <TextView style="@style/Label" android:text="Nama petugas" />
            <EditText
                android:id="@+id/etPetugas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:importantForAutofill="no" />

            <TextView style="@style/Label" android:text="Alamat laptop (contoh 192.168.43.20:8000)" />
            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:importantForAutofill="no" />

            <TextView style="@style/Label" android:text="PIN checkpoint (lihat di laptop)" />
            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:importantForAutofill="no" />

            <TextView style="@style/Label" android:text="Abaikan pindaian ulang BIB yang sama dalam (detik)" />
            <EditText
                android:id="@+id/etDedupe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:text="Simpan &amp; tes koneksi"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHasilTes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="15sp"
                android:textColor="@color/tinta" />

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/redup" />

            <Button
                android:id="@+id/btnHapus"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Hapus semua data di HP ini"
                android:textColor="@color/buruk" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
